{
  "name": "album-forum-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "相册 / 视频论坛管理后台 (Vue3 + TypeScript + Pinia)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "webpack serve --config webpack.config.cjs --mode development",
    "build": "webpack --config webpack.config.cjs --mode production",
    "preview": "webpack serve --config webpack.config.cjs --mode production",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,scripts,*.cjs,*.mjs,*.json,*.md}\"",
    "format:check": "prettier --check \"{src,scripts,*.cjs,*.mjs,*.json,*.md}\"",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "marked": "^18.1.0",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/nprogress": "^0.2.3",
    "@vue/compiler-sfc": "^3.5.43",
    "axios-mock-adapter": "^2.1.0",
    "css-loader": "^7.1.5",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^3.3.13",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
