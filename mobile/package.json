{
  "name": "fde-study-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "洛可可风格多端应用：Vue3 + TypeScript + uni-app + Pinia + SCSS",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:app": "uni build -p app",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,*.ts,*.mjs,*.json,*.md}\"",
    "format:check": "prettier --check \"{src,*.ts,*.mjs,*.json,*.md}\"",
    "icons:build": "node scripts/generate-icons.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@dcloudio/uni-app": "vue3",
    "@dcloudio/uni-app-plus": "vue3",
    "@dcloudio/uni-components": "vue3",
    "@dcloudio/uni-h5": "vue3",
    "@dcloudio/uni-mp-weixin": "vue3",
    "pinia": "2.1.7",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "vue3",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vue/compiler-sfc": "3.4.21",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "lucide-static": "^1.57.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "subset-font": "^2.9.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "5.2.8",
    "vue-tsc": "^2.2.0"
  }
}
