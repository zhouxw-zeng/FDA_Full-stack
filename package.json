{
  "name": "fde-study-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "全栈 FDE 学习工程：前端管理后台 (admin) + 移动端 (mobile) + 后端 API (server)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm -C admin dev",
    "dev:admin": "pnpm -C admin dev",
    "dev:h5": "pnpm -C mobile dev:h5",
    "dev:wx": "pnpm -C mobile dev:mp-weixin",
    "dev:server": "npm --prefix server run start:dev",
    "build": "npm run build:admin && npm run build:mobile:h5 && npm run build:server",
    "build:admin": "pnpm -C admin build",
    "build:mobile:h5": "pnpm -C mobile build:h5",
    "build:mobile:mp-weixin": "pnpm -C mobile build:mp-weixin",
    "build:mobile:app": "pnpm -C mobile build:app",
    "build:server": "npm --prefix server run build",
    "typecheck:admin": "pnpm -C admin typecheck",
    "typecheck:mobile": "pnpm -C mobile typecheck",
    "lint:admin": "pnpm -C admin lint",
    "lint:mobile": "pnpm -C mobile lint",
    "verify:mobile": "pnpm -C mobile verify",
    "smoke:admin": "pnpm -C admin smoke"
  }
}

